{
  "name": "simup",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive CLI for opening iOS simulators and Android emulators",
  "type": "module",
  "bin": {
    "simup": "./dist/cli.js",
    "opensimu": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": { "@inquirer/prompts": "^7.0.0" },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "engines": { "node": ">=20" }
}
